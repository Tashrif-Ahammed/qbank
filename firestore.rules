rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }
    function admin() { return signed() && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    function open() { return !exists(/databases/$(db)/documents/settings/app) || get(/databases/$(db)/documents/settings/app).data.get('signup', true) == true; }

    match /settings/app { allow read: if true; allow write: if admin(); }
    match /stats/app {
      allow read: if signed();
      allow write: if admin();
      allow update: if signed()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visits','users'])
        && request.resource.data.get('visits',0) - resource.data.get('visits',0) <= 1
        && request.resource.data.get('users',0) - resource.data.get('users',0) <= 1;
    }
    match /users/{u} {
      allow read: if signed() && (request.auth.uid == u || admin());
      allow create: if signed() && request.auth.uid == u && open();
      allow update: if signed() && request.auth.uid == u
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n','r','last'])
        && (request.resource.data.r == resource.data.r || resource.data.r == '');
      allow delete: if signed() && (request.auth.uid == u || admin());
    }
    match /private/{u} { allow read, write: if signed() && request.auth.uid == u; }
    match /admins/{u} { allow read: if signed() && request.auth.uid == u; allow write: if false; }
    match /files/{f} {
      allow read: if signed();
      allow write: if admin();
      allow update: if signed()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['v'])
        && request.resource.data.v == resource.data.v + 1;
      match /parts/{p} { allow read: if signed(); allow write: if admin(); }
    }
    match /posts/{p} { allow read: if signed(); allow write: if admin(); }
    match /events/{e} {
      allow create: if signed() && request.resource.data.uid == request.auth.uid;
      allow read: if admin();
    }
    match /feedback/{x} {
      allow create: if signed() && request.resource.data.ok == false
        && ((request.resource.data.an == true && !('uid' in request.resource.data)) || request.resource.data.uid == request.auth.uid);
      allow read, update, delete: if admin();
    }
  }
}
